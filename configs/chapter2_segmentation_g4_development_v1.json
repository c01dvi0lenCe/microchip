{
  "schema": "dmf_real_segmentation_g4_matched_development_v1",
  "simulation": false,
  "research_role": "same_day_internal_development_validation_not_independent_test",
  "models": ["unet", "deeplabv3plus"],
  "smp_version": "0.5.0",
  "encoder": "resnet34",
  "encoder_depth": 5,
  "pretrained_source": "torchvision.ResNet34_Weights.IMAGENET1K_V1",
  "input_size": 512,
  "input_layout": "RGB_NCHW_ImageNet_mean_std",
  "seed": 269000,
  "batch_size": 4,
  "max_epochs": 60,
  "early_stop_patience": 12,
  "best_metric": "native_val_image_macro_dice",
  "improvement_minimum": 1e-8,
  "optimizer": "AdamW",
  "learning_rate": 0.0001,
  "weight_decay": 0.0001,
  "scheduler": null,
  "amp": "float16",
  "loss": "0.5_per_image_masked_BCE_logits+0.5_per_image_masked_soft_Dice_smooth1",
  "threshold": 0.5,
  "augment": {
    "horizontal_flip_probability": 0.5,
    "vertical_flip_probability": 0.5,
    "quarter_turns_uniform": [0, 1, 2, 3],
    "brightness_offset_uniform": [-0.05, 0.05],
    "contrast_factor_uniform": [0.9, 1.1],
    "key": "sha256(seed:epoch:sample_id)"
  },
  "warmup_inferences": 5,
  "timed_repeats_per_image": 10,
  "torch_cpu_threads": 4,
  "opencv_threads": 1,
  "workers": 0,
  "cudnn_benchmark": false,
  "cudnn_deterministic": true,
  "deterministic_algorithms": "warn_only",
  "formal_test_released": false
}
